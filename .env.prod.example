# ============================================================================
# Production environment for deploy/docker-compose.yml
# Copy to `$VPS_PATH/.env.prod` ON THE VPS and fill in REAL values.
# NEVER commit `.env.prod`. CI never syncs it — secrets live only on the box.
#   chmod 600 .env.prod
# ============================================================================

NODE_ENV=production
PORT=3000

# ── Postgres (internal service "postgres", never published) ──────────────────
POSTGRES_USER=digital_card
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=digital_card

# DATABASE_URL is OVERRIDDEN by the compose x-db-env (built from POSTGRES_*
# + internal DNS). This line is only a fallback for non-compose use.
DATABASE_URL=postgresql://digital_card:change-me-strong-db-password@postgres:5432/digital_card?schema=public

# ── Prebuilt images (GHCR) ──────────────────────────────────────────────────
# Per-service tags (SERVER_IMAGE_TAG) are managed by rollout.sh in
# service-tags.env — do NOT set them here.
IMAGE_REPO=ghcr.io/shoha-coder/digital-card
